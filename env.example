DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,aicentral.network
DJANGO_CSRF_TRUSTED_ORIGINS=https://aicentral.network

POSTGRES_DB=ia_central
POSTGRES_USER=ia_central
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Gateway LiteLLM (ADR-012, ADR-015)
ANTHROPIC_API_KEY=change-me
LITELLM_MASTER_KEY=change-me

# ntfy (ADR-018)
NTFY_URL=https://ntfy.aicentral.network
NTFY_TOPIC=change-me-to-a-topic-name
NTFY_TOKEN=change-me

# Servicio orchestrator (ADR-017, ADR-021) — nunca cablear estos valores en
# docker-compose.yml ni en el código, deben quedar parametrizados acá.
# UID real del propietario del credencial de suscripción en este host.
ORCHESTRATOR_UID=1001
# Ruta real del credencial de suscripción en este host — no depende de $HOME
# del usuario que corre `docker compose` (puede diferir de quien lo invoque).
ORCHESTRATOR_CREDENTIALS_PATH=/home/fernando/.claude/.credentials.json

# Sidecar admin-tasks (ADR-023) — token compartido entre admin-tasks y
# orchestrator, defensa en profundidad además del aislamiento de red interna.
ADMIN_TASKS_TOKEN=change-me

# Campo cifrado de credenciales de proyecto de la sala (ADR-025 punto 8).
# Clave(s) Fernet válidas (base64 urlsafe de 32 bytes), separadas por coma
# para rotación futura vía MultiFernet — la primera cifra, todas descifran.
# Separada de DJANGO_SECRET_KEY a propósito. Sin default: si falta o es
# inválida, apps/sala/fields.py falla al arrancar, no en silencio.
CREDENTIALS_ENCRYPTION_KEY=change-me
